# ── LAST BREATH environment ────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Never commit real keys.
#
# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Supabase anon (publishable) key. This is a PUBLIC key, protected by RLS.
VITE_SUPABASE_ANON_KEY=
# Optional: base URL for auth email redirects. Defaults to window.location.origin.
VITE_SITE_URL=

# ── Server-only (never prefix with VITE_, never expose to the client) ──────────
# Used ONLY by scripts/tests that need admin access (e.g. local verification).
SUPABASE_SERVICE_ROLE_KEY=
# Connection string used by `supabase db` tooling / migrations.
DATABASE_URL=
